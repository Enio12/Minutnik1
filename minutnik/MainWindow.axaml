<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="420"
        Width="450" Height="420"
        WindowStartupLocation="CenterScreen"
        x:Class="minutnik.MainWindow"
        Title="Minutnik">

    <StackPanel Margin="24" Spacing="16" HorizontalAlignment="Center">
        <!-- Nagłówek i faza -->
        <TextBlock Text="Minutnik"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />

        <TextBlock x:Name="PhaseTextBlock"
                   Text="Praca"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#2563EB"
                   HorizontalAlignment="Center" />

        <!-- Czas mm:ss -->
        <TextBlock x:Name="TimeTextBlock"
                   Text="25:00"
                   FontSize="56"
                   FontWeight="Bold"
                   FontFamily="Consolas, Cascadia Code, monospace"
                   HorizontalAlignment="Center" />

        <!-- Licznik ukończonych cykli -->
        <TextBlock x:Name="CyclesTextBlock"
                   Text="Skończone cykle: 0"
                   FontSize="16"
                   FontWeight="Medium"
                   HorizontalAlignment="Center" />

        <ListBox Name="HistoryList" Height="90" Width="260" />

        <!-- Ustawienia czasu pracy i przerwy -->
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,8" HorizontalAlignment="Center">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Czas pracy (min):"
                       VerticalAlignment="Center"
                       Margin="0,0,12,8" />
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                           x:Name="WorkDurationInput"
                           Minimum="1"
                           Maximum="180"
                           Increment="1"
                           Value="25"
                           FormatString="0"
                           Width="120"
                           Margin="0,0,0,8"
                           ValueChanged="OnWorkDurationChanged" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Czas przerwy (min):"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           x:Name="BreakDurationInput"
                           Minimum="1"
                           Maximum="60"
                           Increment="1"
                           Value="5"
                           FormatString="0"
                           Width="120"
                           ValueChanged="OnBreakDurationChanged" />
        </Grid>

        <!-- Przyciski Start/Pauza i Reset -->
        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="StartPauseButton"
                    Content="Start"
                    Width="110"
                    Height="40"
                    FontSize="16"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnStartPauseClick" />

            <Button x:Name="ResetButton"
                    Content="Reset"
                    Width="110"
                    Height="40"
                    FontSize="16"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnResetClick" />
        </StackPanel>
    </StackPanel>
</Window>
